    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Radish Concepts",
            "email": "support@radishconcepts.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "deployer/deployer": "^7.0",
        "laravel/prompts": "^0.1 || ^0.2 || ^0.3"
    },
    "autoload": {
        "psr-4": {
            "Radishconcepts\\Deployer\\Wp\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
